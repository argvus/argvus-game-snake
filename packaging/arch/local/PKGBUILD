# Maintainer: William C. Canin
pkgname=argvus-game-snake
pkgver=0.1.0
pkgrel=1
pkgdesc="Retro terminal Snake game for the ARGVUS desktop"
arch=('x86_64')
url="https://github.com/argvus/argvus-game-snake"
license=('GPL-3.0-only')
depends=('argvus' 'argvus-app-profiles' 'argvus-appearance' 'gcc-libs' 'glibc')
makedepends=('cargo')
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=()

_source_dir() {
  printf '%s\n' "${srcdir}/${pkgname}-${pkgver}"
}

_cargo_target_dir() {
  printf '%s\n' "${CARGO_TARGET_DIR:-"${srcdir}/target"}"
}

build() {
  [[ -d "$srcdir/argvus" ]] || {
    printf '%s\n' 'the argvus workspace sources are required' >&2
    return 1
  }
  cd "$(_source_dir)"
  local cargo_target_dir
  cargo_target_dir="$(_cargo_target_dir)"
  export CARGO_TARGET_DIR="$cargo_target_dir"
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=."
  cargo build --workspace --release --locked
}

check() {
  cd "$(_source_dir)"
  local cargo_target_dir
  cargo_target_dir="$(_cargo_target_dir)"
  export CARGO_TARGET_DIR="$cargo_target_dir"
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=."
  cargo test --workspace --release --locked
}

package() {
  cd "$(_source_dir)"
  local cargo_target_dir
  cargo_target_dir="$(_cargo_target_dir)"

  install -Dm755 "${cargo_target_dir}/release/${pkgname}" "${pkgdir}/usr/lib/argvus/commands/game-snake"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 src/usr/share/applications/argvus-game-snake.desktop \
    "${pkgdir}/usr/share/applications/argvus-game-snake.desktop"
}
