# Maintainer: William C. Canin
pkgname=argvus-game-snake
pkgver=0.1.0
pkgrel=1
pkgdesc="Retro terminal Snake game for the ARGVUS desktop"
arch=('x86_64')
url="https://github.com/argvus/argvus-game-snake"
license=('GPL-3.0-only')
depends=('argvus-app-profiles' 'argvus-appearance' 'argvus-i18n' 'gcc-libs' 'glibc')
makedepends=('cargo')
options=('!debug')
source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
  "argvus-i18n-main.tar.gz::https://github.com/argvus/argvus-i18n/archive/refs/heads/main.tar.gz"
  "argvus-tui-main.tar.gz::https://github.com/argvus/argvus-tui/archive/refs/heads/main.tar.gz"
)
sha256sums=()

_source_dir() {
  find "${srcdir}" -mindepth 1 -maxdepth 1 -type d -print -quit
}

build() {
  mv "$srcdir/argvus-i18n-main" "$srcdir/argvus-i18n"
  mv "$srcdir/argvus-tui-main" "$srcdir/argvus-tui"
  cd "$(_source_dir)"
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=."
  cargo build --workspace --release --locked
}

check() {
  cd "$(_source_dir)"
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=."
  cargo test --workspace --release --locked
}

package() {
  cd "$(_source_dir)"

  install -Dm755 "target/release/${pkgname}" "${pkgdir}/usr/lib/argvus/commands/${pkgname}"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 packaging/arch/usr/share/applications/argvus-game-snake.desktop \
    "${pkgdir}/usr/share/applications/argvus-game-snake.desktop"
}
